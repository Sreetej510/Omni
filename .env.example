# Brave Search API (Primary search provider)
BRAVE_API_KEY=your_brave_api_key_here

# Model Configuration
MODEL_BASE_URL=http://localhost:8016/v1
MODEL_NAME=your_model_name

# OpenAlex API (Academic paper search)
# Get free API key at: https://openalex.org/settings/api
# Free tier: $1/day, or use key for higher limits (10K searches, 100 PDF downloads/day)
OPENALEX_API_KEY=your_openalex_api_key_here
